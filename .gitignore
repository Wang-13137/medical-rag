# Python
__pycache__/
*.py[cod]
*.egg-info/

# 测试
.pytest_cache/
.coverage

# 构建产物（索引可随时重建）
data/index/

# 真实语料不入库（样例数据 data/smoke 需要保留在版本库中）
data/raw/
# 清洗后的派生语料同样不入库
data/clean/
# 原始采集物（PDF/HTML）同样不入库，避免二次分发指南原文
data/source_original/
# 生成的答案与上下文快照（含指南原文片段，避免二次分发；评测汇总走 reports/）
data/generated/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
